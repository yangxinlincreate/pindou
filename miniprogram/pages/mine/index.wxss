.row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F2EDE4;
}.row:last-child {
  border-bottom: none;
}
.row .k {
  font-size: 26rpx;
  color: #6B6760;
}
.row .v {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 500;
}

.picker {
  height: 88rpx;
  background: #fff;
  border: 1rpx solid #E7E1D7;
  border-radius: 18rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}
.picker-arrow {
  margin-left: auto;
  color: #9C978E;
  font-size: 32rpx;
}

.btn-ghost.wide {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}

.linkrow {
  height: 92rpx;
  background: #fff;
  border: 1rpx solid #E7E1D7;
  border-radius: 18rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}
.linkrow .arrow {
  margin-left: auto;
  color: #9C978E;
}

.source {
  margin-top: 18rpx;
  font-size: 19rpx;
  color: #B4AFA6;
  line-height: 1.7;
  padding: 0 8rpx;
}

.footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 20rpx;
  color: #C4BFB6;
}

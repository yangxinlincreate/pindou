.stats {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}
.stat {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background: #fff;
  border: 1rpx solid #E7E1D7;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
}
.stat .k {
  font-size: 21rpx;
  color: #9C978E;
  margin-bottom: 8rpx;
}
.stat .v {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.1;
}
.stat .u {
  font-size: 22rpx;
  font-weight: 400;
  color: #9C978E;
  margin-left: 6rpx;
}

.label .flag {
  margin-left: auto;
  color: #C9501F;
  font-size: 22rpx;
}

.list {
  background: #fff;
  border: 1rpx solid #E7E1D7;
  border-radius: 22rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F2EDE4;
}
.row:last-child {
  border-bottom: none;
}

.sw {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  margin-right: 18rpx;
}

.code {
  width: 80rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.name {
  flex: 1;
  font-size: 23rpx;
  color: #6B6760;
}

.need {
  font-size: 19rpx;
  color: #854F0B;
  background: #FAEEDA;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}

.cnt {
  font-size: 26rpx;
  font-weight: 500;
  min-width: 70rpx;
  text-align: right;
}

.disclose {
  margin-top: 28rpx;
  font-size: 20rpx;
  color: #9C978E;
  line-height: 1.7;
  background: #F7F4EE;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.copybtn {
  margin-top: 30rpx;
}

.empty {
  padding: 200rpx 0;
  text-align: center;
  color: #9C978E;
  font-size: 26rpx;
}

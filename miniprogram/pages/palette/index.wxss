.wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

.detail {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: #fff;
  border-bottom: 1rpx solid #F2EDE4;
  padding: 24rpx 30rpx;
  min-height: 150rpx;
}

.bigsw {
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  margin-right: 26rpx;
}

.dinfo {
  display: flex;
  flex-direction: column;
}
.dcode {
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.2;
}
.dname {
  font-size: 24rpx;
  color: #6B6760;
  margin-top: 4rpx;
}
.dhex {
  font-size: 21rpx;
  color: #9C978E;
  margin-top: 4rpx;
}
.dempty {
  font-size: 24rpx;
  color: #9C978E;
}

.scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 40rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 16.66%;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sw {
  width: 100%;
  padding-top: 100%;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.code {
  font-size: 19rpx;
  color: #6B6760;
  margin-top: 6rpx;
}

.disclose {
  margin: 30rpx 8rpx 0;
  font-size: 20rpx;
  color: #9C978E;
  line-height: 1.7;
}
